# local 개발 환경
VUE_APP_ENV=local
VUE_APP_IS_SERVER_API=false
VUE_APP_API_BASE_URL=/api
VUE_APP_API_SERVER_TARGET=http://localhost:8081
VUE_APP_API_TIMEOUT=15000
VUE_APP_HTTPS=false
VUE_APP_SYSTEM_USE_REAL_API=true
# system settings defaults
VUE_APP_SYSTEM_PLATFORM_OVERRIDE=auto
VUE_APP_SYSTEM_MOBILE_BREAKPOINT=768
VUE_APP_SYSTEM_KEYBOARD_MODE=adjustResize
VUE_APP_SYSTEM_USE_VIRTUAL_KEYBOARD=true
VUE_APP_SYSTEM_SHOW_VIRTUAL_KEYBOARD_DEBUG=false
VUE_APP_SYSTEM_VIRTUAL_KEYBOARD_HEIGHT=340
VUE_APP_SYSTEM_BOTTOM_SHEET_MIN_HEIGHT=260
VUE_APP_SYSTEM_BOTTOM_SHEET_MAX_HEIGHT=720
VUE_APP_SYSTEM_USE_MICROPHONE=false
VUE_APP_SYSTEM_SHOW_GUIDE_BUTTON=false
VUE_APP_SYSTEM_SHOW_THEME_BUTTON=false
VUE_APP_SYSTEM_SHOW_SWAGGER_BUTTON=false
VUE_APP_SYSTEM_SHOW_NOTICE_MENU=true
VUE_APP_SYSTEM_SHOW_PRIVACY_MENU=true
VUE_APP_SYSTEM_SHOW_TERMS_MENU=true
VUE_APP_SYSTEM_SHOW_PERSONALIZATION_MENU=true
VUE_APP_SYSTEM_SHOW_PLAYGROUND_MENU=false
VUE_APP_SYSTEM_SHOW_LOGOUT_BUTTON=true
VUE_APP_SYSTEM_SHOW_MOBILE_API_PROGRESS=true
VUE_APP_SYSTEM_AUTO_SCROLL_ON_ANSWER=false
VUE_APP_SYSTEM_ABORT_CHAT_ON_MOBILE_BACKGROUND=true

# auth guard defaults
VUE_APP_ENABLE_AUTH_GUARD=true
VUE_APP_USE_MOCK_AUTH=false
VUE_APP_ALLOW_LOCAL_STORAGE_MOCK_AUTH=false
VUE_APP_MOCK_AUTH_SCENARIO=authenticated
VUE_APP_ENABLE_AUTH_GUARD_CACHE=false
VUE_APP_ENABLE_AUTH_GUARD_DEBUG=false
VUE_APP_AUTH_TIMEOUT=15000
