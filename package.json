{
  "name": "vue3-dsllm-webapp",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "serve": "node node_modules/@vue/cli-service/bin/vue-cli-service.js serve",
    "build": "node node_modules/@vue/cli-service/bin/vue-cli-service.js build",
    "lint": "node node_modules/eslint/bin/eslint.js --ext .js,.vue src",
    "lint:fix": "node node_modules/eslint/bin/eslint.js --ext .js,.vue src --fix",
    "format": "node node_modules/prettier/bin/prettier.cjs --write \"src/**/*.{js,vue,json,css,md}\"",
    "serve:local": "node node_modules/@vue/cli-service/bin/vue-cli-service.js serve --mode local",
    "serve:dev": "node node_modules/@vue/cli-service/bin/vue-cli-service.js serve --mode dev",
    "build:dev": "node node_modules/@vue/cli-service/bin/vue-cli-service.js build --mode dev",
    "build:prod": "node node_modules/@vue/cli-service/bin/vue-cli-service.js build --mode prod",
    "madge:graph": "madge --image graph.png src",
    "madge:chat": "madge --image madge-chat.svg src/components/chat",
    "madge:stores": "madge --image madge-stores.svg src/stores",
    "madge:composables": "madge --image madge-composables.svg src/composables",
    "madge:overlay": "madge --image madge-overlay.svg src/components/overlay",
    "madge:platform": "madge --image madge-platform.svg src/platform",
    "madge:circular": "madge --circular src",
    "madge:orphans": "madge --orphans src",
    "depcruise": "depcruise src --no-config --include-only \"^src\" --output-type html > dependency-report.html",
    "depcruise:circular": "depcruise src --no-config --output-type err",
    "depcruise:composables": "depcruise src/composables --no-config --output-type html > composables-report.html",
    "depcruise:stores": "depcruise src/stores --no-config --output-type html > stores-report.html",
    "depcruise:chat": "depcruise src/components/chat --no-config --output-type html > chat-report.html",
    "depcruise:json": "depcruise src --no-config --output-type json > dependency-report.json"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@floating-ui/vue": "^1.1.6",
    "@vue/cli-service": "^5.0.8",
    "@vueuse/core": "^10.11.0",
    "axios": "^1.6.8",
    "core-js": "^3.37.1",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.45",
    "pinia": "^2.3.1",
    "rehype-external-links": "^3.0.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "swagger-ui-dist": "^5.32.5",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vue": "^3.4.21",
    "vue-i18n": "^9.10.2",
    "vue-router": "^4.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.25.9",
    "dependency-cruiser": "^17.4.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.33.0",
    "madge": "^8.0.0",
    "prettier": "^3.3.3"
  }
}
